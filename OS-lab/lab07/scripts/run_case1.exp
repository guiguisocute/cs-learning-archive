#!/usr/bin/expect -f

set timeout -1
match_max 100000

proc next_line {linesVar indexVar what} {
    upvar 1 $linesVar lines
    upvar 1 $indexVar index

    if {$index >= [llength $lines]} {
        error "输入文件缺少${what}"
    }

    set value [lindex $lines $index]
    incr index
    return $value
}

proc load_case_lines {case_file} {
    set fh [open $case_file r]
    fconfigure $fh -encoding utf-8 -translation lf
    set content [read $fh]
    close $fh

    set lines {}
    foreach raw_line [split $content "\n"] {
        set line [string trim $raw_line]
        if {$line eq ""} {
            continue
        }
        lappend lines $line
    }
    return $lines
}

proc replay_case {binary case_file} {
    set lines [load_case_lines $case_file]
    set index 0

    set partition_count [next_line lines index "分区块数"]
    set partition_lines {}
    for {set i 0} {$i < $partition_count} {incr i} {
        lappend partition_lines [next_line lines index "分区信息"]
    }

    set job_count [next_line lines index "作业个数"]
    set job_sizes {}
    for {set i 1} {$i <= $job_count} {incr i} {
        lappend job_sizes [next_line lines index "作业${i}大小"]
    }

    set recycle_ops {}
    while {$index < [llength $lines]} {
        set choice [next_line lines index "是否回收选项"]
        lappend recycle_ops [list choice $choice]
        if {[string equal -nocase $choice "y"]} {
            lappend recycle_ops [list job [next_line lines index "回收作业名"]]
        }
    }

    spawn -noecho $binary

    expect -exact "请输入系统的分区块数："
    send -- "${partition_count}\r"

    expect -re {分区号 大小 起始\r?\n}
    foreach line $partition_lines {
        send -- "${line}\r"
    }

    expect -exact "请输入作业的个数："
    send -- "${job_count}\r"

    set job_index 1
    foreach job_size $job_sizes {
        expect -exact "请输入作业${job_index}的大小："
        send -- "${job_size}\r"
        incr job_index
    }

    foreach op $recycle_ops {
        set kind [lindex $op 0]
        set value [lindex $op 1]

        if {$kind eq "choice"} {
            expect -exact "是否需要回收(y/n)？"
            send -- "${value}\r"
            continue
        }

        expect -exact "请输入回收的作业名："
        send -- "${value}\r"
    }

    expect eof
}

set script_dir [file dirname [file normalize [info script]]]
set project_dir [file dirname $script_dir]
set binary [file join $project_dir build fixed_partition_lab]

if {[catch {exec make -C $project_dir} build_output]} {
    send_user "$build_output\n"
    exit 1
}

if {$argc > 0 && [lindex $argv 0] eq "--all"} {
    set case_files [lsort [concat \
        [glob -nocomplain [file join $project_dir data case*.in]] \
        [glob -nocomplain [file join $project_dir data case*.txt]]]]

    foreach case_file $case_files {
        if {![file isfile $case_file]} {
            continue
        }
        send_user "===== [file tail $case_file] =====\n"
        if {[catch {replay_case $binary $case_file} replay_error]} {
            send_user "回放失败：$replay_error\n"
            exit 1
        }
    }
} else {
    if {$argc > 0} {
        set case_file [file normalize [lindex $argv 0]]
    } else {
        set case_file [file join $project_dir data case1.txt]
    }
    if {![file isfile $case_file]} {
        send_user "输入文件不存在：$case_file\n"
        exit 1
    }
    if {[catch {replay_case $binary $case_file} replay_error]} {
        send_user "回放失败：$replay_error\n"
        exit 1
    }
}
