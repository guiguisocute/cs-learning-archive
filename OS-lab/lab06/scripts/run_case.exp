#!/usr/bin/expect -f

set timeout 10

proc run_case {case_path} {
    spawn ./banker_lab
    set fp [open $case_path r]

    while {[gets $fp line] >= 0} {
        if {$line eq ""} {
            continue
        }
        send -- "$line\r"
        after 80
    }

    close $fp
    expect eof
}

if {$argc != 1} {
    puts "用法: scripts/run_case.exp <case-file>|--all"
    exit 1
}

if {[lindex $argv 0] eq "--all"} {
    foreach case_file [lsort [glob -nocomplain data/case*.in data/case*.txt]] {
        puts "===== $case_file ====="
        run_case $case_file
    }
    exit 0
}

run_case [lindex $argv 0]
